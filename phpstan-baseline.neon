parameters:
	ignoreErrors:
		-
			message: '#^Called ''env'' outside of the config directory which returns null when the config is cached, use ''config''\.$#'
			identifier: larastan.noEnvCallsOutsideOfConfig
			count: 7
			path: app/Console/Commands/ValidateEnv.php

		-
			message: '#^Called ''pluck'' on Laravel collection, but could have been retrieved as a query\.$#'
			identifier: larastan.noUnnecessaryCollectionCall
			count: 1
			path: core/app/Core/Services/PermissionService.php

		-
			message: '#^Access to an undefined property Fynla\\Packs\\Gb\\Estate\\GiftingStrategyOptimizer\:\:\$taxCalculator\.$#'
			identifier: property.notFound
			count: 1
			path: packs/country-gb/src/Estate/GiftingStrategyOptimizer.php

