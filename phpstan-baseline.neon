		-
			message: '#^Access to an undefined property Fynla\\Packs\\Gb\\Savings\\SavingsActionDefinitionService\:\:\$taxCalculator\.$#'
			identifier: property.notFound
			count: 1
			path: packs/country-gb/src/Savings/SavingsActionDefinitionService.php

		-
